# ==============================================================================
# TrippyGo Itinerary Engine — Environment Configuration
# ==============================================================================

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"

# Cryptographic & Authentication Secrets
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-this-to-a-secure-32-char-random-secret-in-production"
INTERNAL_RENDER_SECRET="change-this-to-a-secure-render-secret-in-production"

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://trippygo:localdev@localhost:5432/trippygo"

# Transactional Email Service (Resend)
# Leave empty in local development to print invite & reset links to console
RESEND_API_KEY=""
EMAIL_FROM="TrippyGo Operations <operations@trippygo.com>"

# AI Ingestion & Extraction Keys
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-7-sonnet-20250219"
OPENAI_API_KEY=""

# Media & Stock Photography APIs
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""

# Object Storage (AWS S3 or MinIO)
S3_BUCKET="trippygo-itineraries"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_ENDPOINT="http://localhost:9000"
S3_FORCE_PATH_STYLE="true"

# Headless Renderer Service (Playwright Chromium)
RENDERER_SERVICE_URL="http://localhost:3001"
